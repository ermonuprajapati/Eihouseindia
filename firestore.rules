rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default: deny unless explicitly allowed below
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Core Security & Identity Primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrapAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'er.monuprajapati.2024@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrapAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isEditor() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/editors/$(request.auth.uid))
      );
    }

    function isActiveUser() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE'
      );
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'username', 'displayName', 'avatar', 'bio', 'website', 'role', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 30
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.role in ['USER', 'EDITOR', 'ADMIN']
        && data.status in ['ACTIVE', 'SUSPENDED'];
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll(['uid', 'username', 'displayName', 'avatar', 'bio', 'website', 'role', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 30
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.role in ['USER', 'EDITOR', 'ADMIN']
        && data.status in ['ACTIVE', 'SUSPENDED'];
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    // 1. Private User Accounts
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().role == 'USER';
      allow update: if isSignedIn()
        && isValidId(userId)
        && (
          (isOwner(userId) && incoming().uid == existing().uid && incoming().role == existing().role) ||
          isAdmin()
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // 2. Public Author Profiles
    match /publicProfiles/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidPublicProfile(incoming())
        && incoming().uid == request.auth.uid;
      allow update: if isSignedIn()
        && isValidId(userId)
        && (
          (isOwner(userId) && incoming().uid == existing().uid) ||
          isAdmin()
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // 3. Role Marker Collections
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(userId);
    }

    match /editors/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(userId);
    }

    // 4. Articles & Blog Posts
    match /posts/{postId} {
      allow get: if isValidId(postId) && (
        existing().status == 'PUBLISHED' ||
        (isSignedIn() && (existing().authorId == request.auth.uid || isEditor()))
      );
      allow list: if resource.data.status == 'PUBLISHED'
        || (isSignedIn() && resource.data.authorId == request.auth.uid)
        || isEditor();
      allow create: if isSignedIn()
        && isValidId(postId)
        && incoming().id == postId
        && incoming().authorId == request.auth.uid
        && (incoming().status in ['DRAFT', 'PENDING'] || isEditor());
      allow update: if isValidId(postId) && (
        // Allow public view count increment on published posts
        (
          existing().status == 'PUBLISHED' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['viewCount']) &&
          incoming().viewCount is number
        ) ||
        // Allow full edit by author (drafts/pending) or editor/admin
        (
          isSignedIn()
          && incoming().id == existing().id
          && (
            isEditor() ||
            (
              existing().authorId == request.auth.uid
              && incoming().authorId == existing().authorId
              && (incoming().status in ['DRAFT', 'PENDING'] || isEditor())
            )
          )
        )
      );
      allow delete: if isSignedIn()
        && isValidId(postId)
        && (isAdmin() || (existing().authorId == request.auth.uid && existing().status in ['DRAFT', 'PENDING']));
    }

    // 4a. Post View Telemetry
    match /postViews/{viewId} {
      allow create: if isValidId(viewId);
      allow read, delete: if isAdmin();
    }

    // 4b. Site Visits & Visitor Traffic Telemetry
    match /siteVisits/{visitId} {
      allow create: if isValidId(visitId);
      allow read, delete: if isAdmin();
    }

    // 5. Categories
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // 6. Tags
    match /tags/{tagId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() && isValidId(tagId);
      allow delete: if isAdmin() && isValidId(tagId);
    }

    // 7. Comments
    match /comments/{commentId} {
      allow get, list: if true;
      allow create: if isSignedIn()
        && isValidId(commentId)
        && incoming().id == commentId
        && incoming().authorId == request.auth.uid;
      allow update: if isSignedIn()
        && isValidId(commentId)
        && (isEditor() || (existing().authorId == request.auth.uid));
      allow delete: if isSignedIn()
        && isValidId(commentId)
        && (isAdmin() || existing().authorId == request.auth.uid);
    }

    // 8. Media Library & Uploads
    match /media/{mediaId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(mediaId);
      allow delete: if isSignedIn() && (isAdmin() || existing().uploaderId == request.auth.uid);
    }

    match /mediaFiles/{mediaId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 9. Notifications
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(notificationId);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 10. Site Settings & Reports
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isEditor();
      allow create: if isSignedIn() && isValidId(reportId);
      allow update, delete: if isEditor();
    }

    // 11. Public Engagement (Newsletter & Contact Inquiries)
    match /newsletterSubscribers/{subId} {
      allow create: if isValidId(subId) && incoming().email is string;
      allow read, update, delete: if isAdmin();
    }

    match /contactMessages/{msgId} {
      allow create: if isValidId(msgId) && incoming().email is string && incoming().message is string;
      allow read, update, delete: if isAdmin();
    }

    // 12. Immutable Audit & Moderation Logs
    match /moderationLogs/{logId} {
      allow read: if isEditor();
      allow create: if isEditor() && isValidId(logId);
      allow update, delete: if false;
    }
  }
}
